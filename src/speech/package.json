{
  "name": "@alarm/speech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated speech, as its own service. The main API calls it over HTTP.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^17.1.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
