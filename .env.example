# Connection string for the application role (not a superuser).
DATABASE_URL=postgresql://alarm_app:CHANGE_ME@127.0.0.1:5432/alarm_configurator

# Port the API server listens on; it also serves the built SPA.
PORT=8080

# Enables the /api/v1/test/* hooks (T-01..T-03). Any value other than 1 disables them.
TEST_SUPPORT=0

# Anchor instant for deterministic seed data.
SEED_ANCHOR=2026-06-15T18:00:00Z

# Fixed, deliberate delay before the alarm list responds, so the A-01 skeleton is observable.
LIST_DELAY_MS=600

# Secret used to sign session cookies.
SESSION_SECRET=change-me-to-something-long-and-random-at-least-32-chars

# Set to 1 to mark session cookies Secure. Defaults to on when NODE_ENV=production.
COOKIE_SECURE=0

# Whether startup seeds: if-empty (production default), always (dev default), never.
SEED_ON_START=always

# Which profile startup seeds: demo or empty.
SEED_PROFILE=demo

# Outbound email. capture keeps messages in memory (no mail server needed),
# log also prints them, smtp sends over SMTP, brevo posts to Brevo over HTTPS.
# Use brevo anywhere outbound SMTP might be blocked, which includes most
# hosting platforms.
MAIL_TRANSPORT=capture
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=0
# Only for a local catcher such as Mailpit. Never with a real provider.
MAIL_IGNORE_TLS=0
MAIL_FROM=Alarm Configurator <no-reply@alarm-configurator.test>
# Only needed for a real provider:
# MAIL_USER=
# MAIL_PASSWORD=

# Only for MAIL_TRANSPORT=brevo. The REST API key, beginning xkeysib-.
# MAIL_API_KEY=

# Server-side speech. none leaves it to the browser, mock generates real audio
# locally with no account, elevenlabs calls the provider.
TTS_PROVIDER=mock
# TTS_API_KEY=
# TTS_MODEL=eleven_multilingual_v2
